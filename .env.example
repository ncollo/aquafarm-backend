# ==========================================
# Aquafarm Fisheries Backend Configuration
# ==========================================

# Server Port
PORT=5000
NODE_ENV=production

# Azure Database for PostgreSQL (Flexible Server) Connection String
# Format: postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/aquafarm?sslmode=require
DATABASE_URL="postgresql://aquafarmadmin:YourStrongPassword123!@aquafarm-postgres.postgres.database.azure.com:5432/aquafarm?sslmode=require"

# JWT Authentication Secret Key (Use a strong 64-char random string in production)
JWT_SECRET="super-secret-jwt-token-aquafarm-prod-key-2026"

# Frontend Client URL(s) - Comma-separated for multiple origins
CLIENT_URL="https://aquafarm.tech,https://aquafarm-frontend.vercel.app,http://localhost:5173"

# Email Configuration (Nodemailer / SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Safaricom Daraja M-Pesa API Keys (Sandbox / Live)
SAFARICOM_CONSUMER_KEY="your_consumer_key"
SAFARICOM_CONSUMER_SECRET="your_consumer_secret"
SAFARICOM_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
SAFARICOM_SHORTCODE="174379"
SAFARICOM_CALLBACK_URL="https://aquafarm-backend.azurewebsites.net/api/payments/callback"

# ImageKit (Media storage)
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
