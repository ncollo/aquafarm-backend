generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CUSTOMER
}

enum OrderType {
  RETAIL
  WHOLESALE
  CORPORATE
  HOTEL
  FARMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AlertPriority {
  INFO
  MEDIUM
  HIGH
  CRITICAL
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  PENDING_IMAGE
}

enum PondStatus {
  ACTIVE
  MAINTENANCE
}

enum HealthStatus {
  EXCELLENT
  GOOD
  MONITOR
  CRITICAL
}

// ─── User Management ─────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  name         String
  phone        String?    @unique // Crucial for M-Pesa STK push
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true) // For soft-deleting accounts
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  orders       Order[]
  auditLogs    AuditLog[] // Track actions performed by Admin/Manager
}

// ─── Inventory & Suppliers ───────────────────────────────────────────────────

model Supplier {
  id              String      @id @default(uuid())
  name            String
  category        String      // e.g., "Fish Feed", "Equipment"
  contactPhone    String
  outstandingDebt Float       @default(0)
  rating          Int         @default(5)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fishBatches     FishBatch[] // If they supplied fingerlings
}

model FishBatch {
  id                String       @id @default(uuid())
  batchCode         String       @unique // e.g., TS-001
  species           String
  totalKg           Float
  avgWeight         String       // e.g., "450g"
  healthStatus      HealthStatus @default(GOOD)
  expectedHarvest   DateTime?    // Calculated to derive "daysToHarvest"
  pricePerKg        Float
  
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])

  // NEW: A batch can be spread across multiple ponds
  ponds             Pond[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}


// ─── Sales & Orders ──────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  orderType       OrderType   @default(RETAIL)
  totalAmount     Float
  status          OrderStatus @default(PENDING)
  deliveryAddress String?
  deliveryDate    DateTime?
  
  // Guest checkout customer info
  customerName    String?
  customerEmail   String?
  customerPhone   String?

  // NEW: Store the generated PDF receipt URL for admin retrieval
  receiptUrl      String?     

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId          String?
  user            User?       @relation(fields: [userId], references: [id])

  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  
  quantity    Float    // Replaces quantityKg to handle all item types
  subtotal    Float
}

// ─── Financials ──────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  amount            Float
  status            PaymentStatus @default(PENDING)
  mpesaReceipt      String?       @unique // Returned by Safaricom Daraja
  checkoutRequestId String        @unique // Tracks the STK push request
  phoneNumber       String        // Number that actually paid
  paymentDate       DateTime?

  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// ─── System & Monitoring ─────────────────────────────────────────────────────

model Alert {
  id          String        @id @default(uuid())
  message     String
  type        String        // 'warning', 'info', 'success'
  priority    AlertPriority @default(INFO)
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

model AuditLog {
  id          String    @id @default(uuid())
  action      String    // e.g., "Updated price for TS-001" or "Deleted User"
  details     String?   // JSON string of changes
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

model Product {
  id          String        @id @default(uuid())
  name        String
  category    String        // e.g., "fish", "feed", "rods"
  description String?
  price       Float
  unit        String        // e.g., "per kg", "per piece"
  stock       Float         // Float handles both kg (fish) and integers (rods)
  imageUrl    String?       // Firebase Storage URL
  status      ProductStatus @default(AVAILABLE)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems  OrderItem[]
}

// ─── Farm Operations (Ponds & Telemetry) ─────────────────────────────────────

model Pond {
  id              String       @id @default(uuid())
  name            String       @unique // e.g., "Pond RT-003"
  status          PondStatus   @default(ACTIVE)
  
  // Live Water Quality Metrics (Powering the Analytics Dashboard)
  phLevel         Float?       // e.g., 7.2
  dissolvedOxygen Float?       // e.g., 6.8 (mg/L)
  temperature     Float?       // e.g., 24.0 (degC)
  ammonia         Float?       // e.g., 0.2 (ppm)
  lastTestedAt    DateTime     @default(now())
  
  // Relationships
  currentBatchId  String?
  currentBatch    FishBatch?   @relation(fields: [currentBatchId], references: [id])
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}